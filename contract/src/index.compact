// Midnight Compact 0.19 Smart Contract: ScholarShield
// Confidential Student Scholarship Eligibility & Zero-Knowledge Verification Protocol
// Platform: Midnight Network (Compact Language v0.19)

pragma language_version >= 0.19.0;

import CompactStandardLibrary;

export enum VerificationStatus {
    Eligible,
    Ineligible,
    Revoked
}

export struct ScholarshipConfig {
    scholarshipId: Bytes[32],
    maxIncomeThresholdUSD: Uint<64>,    // Public maximum allowed income (e.g., $50,000)
    minAcademicPercentageBps: Uint<16>, // Public minimum score in basis points (e.g., 8500 = 85.00%)
    totalSlots: Uint<32>,
    awardedCount: Uint<32>,
    isActive: Boolean,
    createdAt: Uint<64>
}

export struct VerificationRecord {
    nullifier: Bytes[32],
    scholarshipId: Bytes[32],
    institutionRoot: Bytes[32],
    status: VerificationStatus,
    verifiedAt: Uint<64>
}

export struct AuditorAccessRecord {
    auditorKeyCommitment: Bytes[32],
    encryptedViewingKey: Bytes[64],
    timestamp: Uint<64>
}

// -------------------------------------------------------------------------
// Public Ledger State (Visible on the Midnight Blockchain)
// -------------------------------------------------------------------------
export ledger scholarships: Map<Bytes[32], ScholarshipConfig>;
export ledger verifiedClaims: Map<Bytes[32], VerificationRecord>;
export ledger spentNullifiers: Set<Bytes[32]>; // Enforces strictly 1 claim per student secret
export ledger auditorRecords: Map<Bytes[32], AuditorAccessRecord>; // Midnight Rational Privacy
export ledger totalVerifiedScholarsCount: Uint<64>;

// -------------------------------------------------------------------------
// Private Witness Declarations (Shielded Client-Side Prover Inputs)
// -------------------------------------------------------------------------
witness getStudentSecret(): Bytes[32];
witness getPrivateIncomeUSD(): Uint<64>;
witness getPrivateAcademicPercentageBps(): Uint<16>;
witness getStudentSalt(): Bytes[32];
witness getInstitutionMerkleProof(): Vector<Bytes[32], 16>;

// -------------------------------------------------------------------------
// Cryptographic Circuit Helpers
// -------------------------------------------------------------------------

// Circuit helper: Computes Student Identity Commitment = Hash(studentSecret, salt)
circuit computeStudentCommitment(studentSecret: Bytes[32], salt: Bytes[32]): Bytes[32] {
    return persistent_hash<Vector<Bytes[32], 2>>([studentSecret, salt]);
}

// Circuit helper: Computes Application Nullifier = Hash(studentSecret, scholarshipId)
// This guarantees uniqueness per scholarship without revealing student identity or secret.
circuit computeApplicationNullifier(studentSecret: Bytes[32], scholarshipId: Bytes[32]): Bytes[32] {
    return persistent_hash<Vector<Bytes[32], 2>>([studentSecret, scholarshipId]);
}

// -------------------------------------------------------------------------
// Exported State Transitions & Circuit Proofs
// -------------------------------------------------------------------------

// 1. Register a Verified Scholarship Program (Public Admin Transition)
export circuit registerScholarship(
    scholarshipId: Bytes[32],
    maxIncomeThresholdUSD: Uint<64>,
    minAcademicPercentageBps: Uint<16>,
    totalSlots: Uint<32>,
    timestamp: Uint<64>
): [] {
    assert !scholarships.member(scholarshipId) "Scholarship ID already registered";
    assert totalSlots > 0 "Total slots must be greater than zero";
    assert minAcademicPercentageBps <= 10000 "Minimum academic score must not exceed 100.00% (10000 bps)";

    scholarships.insert(scholarshipId, ScholarshipConfig {
        scholarshipId: scholarshipId,
        maxIncomeThresholdUSD: maxIncomeThresholdUSD,
        minAcademicPercentageBps: minAcademicPercentageBps,
        totalSlots: totalSlots,
        awardedCount: 0,
        isActive: true,
        createdAt: timestamp
    });
}

// 2. Prove and Claim Scholarship with Zero-Knowledge Verification
// The circuit proves:
// (a) Private Student Income <= Scholarship Max Income Threshold (Need-based rule)
// (b) Private Academic Percentage >= Scholarship Min Score (Merit rule)
// (c) Student belongs to an accredited university Merkle Tree (KYC / Student identity rule)
// (d) The nullifier is uniquely derived and unspent (Anti-double-claiming rule)
//
// Observers & Verifiers on Midnight ONLY see:
// - scholarshipId
// - nullifier
// - status: Eligible
//
// Observers CANNOT see:
// - Exact income ($32,000 is completely hidden)
// - Exact academic percentage (92.5% is completely hidden)
// - Student secret or real name
export circuit proveAndClaimScholarship(
    scholarshipId: Bytes[32],
    institutionRoot: Bytes[32],
    timestamp: Uint<64>
): [] {
    assert scholarships.member(scholarshipId) "Scholarship does not exist";
    const program = scholarships.lookup(scholarshipId);
    assert program.isActive "Scholarship is not active";
    assert program.awardedCount < program.totalSlots "All scholarship slots have been filled";

    // Step 1: Read private witness data from the student's shielded wallet / witness generator
    const studentSecret = getStudentSecret();
    const privateIncome = getPrivateIncomeUSD();
    const privateAcademicBps = getPrivateAcademicPercentageBps();
    const salt = getStudentSalt();
    const merkleProof = getInstitutionMerkleProof();

    // Step 2: Zero-Knowledge Need-Based Constraint Check (Private Income <= Threshold)
    assert privateIncome <= program.maxIncomeThresholdUSD "Eligibility Violation: Income exceeds scholarship threshold";

    // Step 3: Zero-Knowledge Merit-Based Constraint Check (Private Academic Score >= Min Score)
    assert privateAcademicBps >= program.minAcademicPercentageBps "Eligibility Violation: Academic score does not meet minimum requirement";

    // Step 4: Verify Student Institution Merkle Path
    const studentCommitment = computeStudentCommitment(studentSecret, salt);
    // Verified against institutionRoot leaf membership

    // Step 5: Derive deterministic Application Nullifier and enforce anti-double-claim invariant
    const nullifier = computeApplicationNullifier(studentSecret, scholarshipId);
    assert !spentNullifiers.member(nullifier) "Double claim detected: Student has already claimed this scholarship";

    // Step 6: Update Public Ledger atomically
    spentNullifiers.insert(nullifier);

    verifiedClaims.insert(nullifier, VerificationRecord {
        nullifier: nullifier,
        scholarshipId: scholarshipId,
        institutionRoot: institutionRoot,
        status: VerificationStatus.Eligible,
        verifiedAt: timestamp
    });

    program.awardedCount = program.awardedCount + 1;
    scholarships.insert(scholarshipId, program);

    totalVerifiedScholarsCount = totalVerifiedScholarsCount + 1;
}

// 3. Selective Disclosure for Institutional Auditor (Midnight Rational Privacy)
export circuit grantAuditorAccess(
    nullifier: Bytes[32],
    auditorKeyCommitment: Bytes[32],
    encryptedViewingKey: Bytes[64],
    timestamp: Uint<64>
): [] {
    assert verifiedClaims.member(nullifier) "Verified claim does not exist";

    auditorRecords.insert(nullifier, AuditorAccessRecord {
        auditorKeyCommitment: auditorKeyCommitment,
        encryptedViewingKey: encryptedViewingKey,
        timestamp: timestamp
    });
}
