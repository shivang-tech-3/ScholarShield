{
  "version": "0.19.0",
  "circuit": "proveAndClaimScholarship",
  "constraints": [
    "assert (privateIncomeUSD <= maxIncomeThresholdUSD)",
    "assert (privateAcademicPercentageBps >= minAcademicPercentageBps)",
    "verifyMerkleMembership(studentCommitment, institutionProof, institutionRoot)",
    "deriveNullifier(studentSecret, scholarshipId)",
    "assertSpentNullifierNotPresent(nullifier)"
  ]
}
